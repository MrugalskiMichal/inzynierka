@page "/dashboard"
@using System.Net.Http.Json
@using Frontend.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Agents Dashboard</h3>
    <button class="btn btn-sm btn-outline-primary" @onclick="ManualRefresh">Refresh</button>
</div>

<div class="container-fluid">

    <!-- CPU + RAM -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="cpuChart"></canvas>
        </div>
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="ramChart"></canvas>
        </div>
    </div>

    <!-- GPU Usage + GPU Temp -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuUsageChart"></canvas>
        </div>
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuTempChart"></canvas>
        </div>
    </div>

    <!-- GPU Mem + Disks -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuMemChart"></canvas>
        </div>

        @foreach (var disk in diskNames)
        {
            <div class="col-md-6 mb-3" style="height:220px">
                <canvas id="diskChart_@disk.Replace(":", "")"></canvas>
            </div>
        }
    </div>

    <h5 class="mt-4">Agents table</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Agent</th>
                <th>CPU %</th>
                <th>RAM MB</th>
                <th>GPU %</th>
                <th>GPU Temp °C</th>
                <th>GPU Mem %</th>
                @foreach (var disk in diskNames)
                {
                    <th>@disk</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (summaries != null)
            {
                @foreach (var s in summaries)
                {
                    <tr>
                        <td>@s.AgentId</td>
                        <td>@(s.Cpu?.ToString("F1") ?? "-")</td>
                        <td>@(s.RamUsedMB?.ToString("F0") ?? "-")</td>
                        <td>@(s.GpuUsage?.ToString("F1") ?? "-")</td>
                        <td>@(s.GpuTemp?.ToString("F1") ?? "-")</td>
                        <td>@(s.GpuMem?.ToString("F1") ?? "-")</td>

                        @foreach (var disk in diskNames)
                        {
                            <td>
                                @(
                                    s.DiskUsage.ContainsKey(disk)
                                    ? s.DiskUsage[disk].ToString("F1")
                                    : "-"
                                )
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    class AgentSummary
    {
        public string AgentId { get; set; } = string.Empty;
        public float? Cpu { get; set; }
        public float? RamUsedMB { get; set; }
        public float? GpuUsage { get; set; }
        public float? GpuTemp { get; set; }
        public float? GpuMem { get; set; }
        public Dictionary<string, double> DiskUsage { get; set; } = new();
    }

    List<AgentSummary>? summaries;
    HashSet<string> diskNames = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = StartAutoRefresh();
    }

    private async Task StartAutoRefresh()
    {
        while (true)
        {
            await Task.Delay(10000);
            await LoadData();
        }
    }

    async Task LoadData()
    {
        try
        {
            var agents = await Http.GetFromJsonAsync<List<AgentDto>>("http://localhost:5286/api/agents");
            if (agents == null) return;

            summaries = new List<AgentSummary>();
            diskNames.Clear();

            var from = DateTime.UtcNow.AddHours(-1).ToString("o");
            var to = DateTime.UtcNow.ToString("o");

            var tasks = agents.Select(a =>
                Http.GetFromJsonAsync<List<MetricDto>>($"http://localhost:5286/api/metrics/agents/{a.AgentId}?from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}"));
            var results = await Task.WhenAll(tasks);

            var labels = agents.Select(a => a.AgentId).ToList();
            var cpuData = new List<float>();
            var ramData = new List<float>();
            var gpuUsageData = new List<float>();
            var gpuTempData = new List<float>();
            var gpuMemData = new List<float>();
            var diskCharts = new Dictionary<string, List<double>>();

            for (int i = 0; i < agents.Count; i++)
            {
                var a = agents[i];
                var metrics = results[i];

                if (metrics != null && metrics.Count > 0)
                {
                    var last = metrics.OrderBy(m => m.Timestamp).Last();
                    var gpu = last.Gpu?.Values.FirstOrDefault();

                    var summary = new AgentSummary
                    {
                        AgentId = a.AgentId,
                        Cpu = last.CpuUsagePercent,
                        RamUsedMB = last.Ram?.UsedRamMB,
                        GpuUsage = gpu?.GpuCoreUsage,
                        GpuTemp = gpu?.GpuCoreTemperature,
                        GpuMem = gpu?.GpuMemoryUsage
                    };

                    cpuData.Add(last.CpuUsagePercent ?? 0);
                    ramData.Add(last.Ram?.UsedRamMB ?? 0);
                    gpuUsageData.Add(gpu?.GpuCoreUsage ?? 0);
                    gpuTempData.Add(gpu?.GpuCoreTemperature ?? 0);
                    gpuMemData.Add(gpu?.GpuMemoryUsage ?? 0);

                    if (last.Disks != null)
                    {
                        foreach (var d in last.Disks)
                        {
                            diskNames.Add(d.Key);

                            if (!diskCharts.ContainsKey(d.Key))
                                diskCharts[d.Key] = new List<double>();

                            diskCharts[d.Key].Add(d.Value.UsageDiskPercent);
                            summary.DiskUsage[d.Key] = d.Value.UsageDiskPercent;
                        }
                    }

                    summaries.Add(summary);
                }
                else
                {
                    summaries.Add(new AgentSummary { AgentId = a.AgentId });
                    cpuData.Add(0);
                    ramData.Add(0);
                    gpuUsageData.Add(0);
                    gpuTempData.Add(0);
                    gpuMemData.Add(0);
                }
            }

            await JSRuntime.InvokeVoidAsync("renderLineChart", "cpuChart", labels, cpuData, "CPU %", "#17a2b8");
            await JSRuntime.InvokeVoidAsync("renderLineChart", "ramChart", labels, ramData, "RAM MB", "#f39c12");
            await JSRuntime.InvokeVoidAsync("renderLineChart", "gpuUsageChart", labels, gpuUsageData, "GPU %", "#9b59b6");
            await JSRuntime.InvokeVoidAsync("renderLineChart", "gpuTempChart", labels, gpuTempData, "GPU Temperature °C", "#e74c3c");
            await JSRuntime.InvokeVoidAsync("renderLineChart", "gpuMemChart", labels, gpuMemData, "GPU Memory %", "#8e44ad");

            foreach (var disk in diskCharts)
            {
                var id = $"diskChart_{disk.Key.Replace(":", "")}";
                await JSRuntime.InvokeVoidAsync("renderLineChart", id, labels, disk.Value, $"Disk {disk.Key}", "#3498db");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    void ManualRefresh() => _ = LoadData();
}
