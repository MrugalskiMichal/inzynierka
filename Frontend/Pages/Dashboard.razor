@page "/dashboard"
@using System.Net.Http.Json
@using Frontend.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Agents Dashboard</h3>
    <button class="btn btn-sm btn-outline-primary" @onclick="ManualRefresh">Refresh</button>
</div>

<div class="container-fluid">

    <!-- CPU + RAM -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="cpuChart"></canvas>
        </div>
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="ramChart"></canvas>
        </div>
    </div>

    <!-- GPU Usage + GPU Temp -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuUsageChart"></canvas>
        </div>
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuTempChart"></canvas>
        </div>
    </div>

    <!-- GPU Mem + Disks -->
    <div class="row">
        <div class="col-md-6 mb-3" style="height:220px">
            <canvas id="gpuMemChart"></canvas>
        </div>
        @foreach (var disk in diskNames)
        {
            <div class="col-md-6 mb-3" style="height:220px">
                <canvas id="diskChart_@disk.Replace(":", "")"></canvas>
            </div>
        }
    </div>

    <h5 class="mt-4">Agents table</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Agent</th>
                <th>CPU %</th>
                <th>RAM %</th>
                <th>GPU %</th>
                <th>GPU Temp °C</th>
                <th>GPU Mem %</th>
                @foreach (var disk in diskNames)
                {
                    <th>@disk</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (summaries != null)
            {
                @foreach (var s in summaries)
                {
                    <tr>
                        <td>@s.AgentId</td>
                        <td>@(s.Cpu?.ToString("F1") ?? "-")</td>
                        <td>@(s.RamUsedMB?.ToString("F1") ?? "-")</td>
                        <td>@(s.GpuUsage?.ToString("F1") ?? "-")</td>
                        <td>@(s.GpuTemp?.ToString("F1") ?? "-")</td>
                        <td>@(s.GpuMem?.ToString("F1") ?? "-")</td>

                        @foreach (var disk in diskNames)
                        {
                            <td>
                                @(
                                    s.DiskUsage.ContainsKey(disk)
                                    ? s.DiskUsage[disk].ToString("F1")
                                    : "-"
                                )
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    class AgentSummary
    {
        public string AgentId { get; set; } = string.Empty;
        public float? Cpu { get; set; }
        public float? RamUsedMB { get; set; }
        public float? GpuUsage { get; set; }
        public float? GpuTemp { get; set; }
        public float? GpuMem { get; set; }
        public Dictionary<string, double> DiskUsage { get; set; } = new();
    }

    List<AgentSummary>? summaries;
    HashSet<string> diskNames = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = StartAutoRefresh();
    }

    private async Task StartAutoRefresh()
    {
        while (true)
        {
            await Task.Delay(10000);
            await LoadData();
        }
    }

    async Task LoadData()
    {
        try
        {
            var agents = await Http.GetFromJsonAsync<List<AgentDto>>("http://localhost:5286/api/agents");
            if (agents == null) return;

            summaries = new List<AgentSummary>();
            diskNames.Clear();

            var from = DateTime.UtcNow.AddHours(-1).ToString("o");
            var to = DateTime.UtcNow.ToString("o");

            // Pobieramy dane per agent
            var tasks = agents.ToDictionary(
                a => a.AgentId,
                a => Http.GetFromJsonAsync<List<MetricDto>>(
                    $"http://localhost:5286/api/metrics/agents/{a.AgentId}?from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}"
                )
            );

            await Task.WhenAll(tasks.Values);

            // Przygotowanie struktur
            var labels = agents.Select(a => a.AgentId).ToList();
            var cpuData = new List<float>();
            var ramData = new List<float>();
            var gpuUsageData = new List<float>();
            var gpuTempData = new List<float>();
            var gpuMemData = new List<float>();

            var allDiskKeys = tasks.Values
                .SelectMany(t => t.Result ?? new List<MetricDto>())
                .Where(m => m.Disks != null)
                .SelectMany(m => m.Disks.Keys)
                .Distinct()
                .ToList();

            diskNames = new HashSet<string>(allDiskKeys);
            var diskCharts = new Dictionary<string, List<double>>();

            foreach (var agent in agents)
            {
                var agentId = agent.AgentId;
                var metrics = tasks[agentId].Result;

                if (metrics != null && metrics.Count > 0)
                {
                    var avgCpu = metrics.Average(m => m.CpuUsagePercent ?? 0);
                    var avgRam = metrics.Average(m => m.Ram?.RamUsageMB ?? 0);
                    var avgGpu = metrics.Average(m => m.Gpu?.Values.FirstOrDefault()?.GpuCoreUsage ?? 0);
                    var avgGpuTemp = metrics.Average(m => m.Gpu?.Values.FirstOrDefault()?.GpuCoreTemperature ?? 0);
                    var avgGpuMem = metrics.Average(m => m.Gpu?.Values.FirstOrDefault()?.GpuMemoryUsage ?? 0);

                    cpuData.Add(avgCpu);
                    ramData.Add(avgRam);
                    gpuUsageData.Add(avgGpu);
                    gpuTempData.Add(avgGpuTemp);
                    gpuMemData.Add(avgGpuMem);

                    var summary = new AgentSummary
                    {
                        AgentId = agentId,
                        Cpu = avgCpu,
                        RamUsedMB = avgRam,
                        GpuUsage = avgGpu,
                        GpuTemp = avgGpuTemp,
                        GpuMem = avgGpuMem
                    };

                    foreach (var diskName in allDiskKeys)
                    {
                        var avgDisk = metrics != null && metrics.Any()
                            ? metrics.Average(m =>
                                m.Disks != null && m.Disks.ContainsKey(diskName)
                                    ? m.Disks[diskName].UsageDiskPercent
                                    : 0)
                            : 0;

                        summary.DiskUsage[diskName] = avgDisk;

                        if (!diskCharts.ContainsKey(diskName))
                            diskCharts[diskName] = new List<double>();

                        diskCharts[diskName].Add(avgDisk);
                    }
                    summaries.Add(summary);
                }
                else
                {
                    // Brak danych – tabela "-"
                    summaries.Add(new AgentSummary { AgentId = agentId });
                    // Wykresy dostają 0 (lub null jeśli chcesz)
                    cpuData.Add(0);
                    ramData.Add(0);
                    gpuUsageData.Add(0);
                    gpuTempData.Add(0);
                    gpuMemData.Add(0);
                }
            }

            // WYKRESY GŁÓWNE
            await JSRuntime.InvokeVoidAsync("renderBarChart", "cpuChart", labels, cpuData, "CPU %", "#17a2b8", new { yMax = 100 });
            await JSRuntime.InvokeVoidAsync("renderBarChart", "ramChart", labels, ramData, "RAM %", "#f39c12", new { yMax = 100 });
            await JSRuntime.InvokeVoidAsync("renderBarChart", "gpuUsageChart", labels, gpuUsageData, "GPU %", "#9b59b6", new { yMax = 100 });
            await JSRuntime.InvokeVoidAsync("renderBarChart", "gpuTempChart", labels, gpuTempData, "GPU Temperature °C", "#e74c3c", new { yMax = 100 });
            await JSRuntime.InvokeVoidAsync("renderBarChart", "gpuMemChart", labels, gpuMemData, "GPU Memory %", "#8e44ad", new { yMax = 100 });

            // WYKRESY DYSKÓW PER AGENT
            foreach (var disk in diskCharts)
            {
                var diskName = disk.Key;
                var id = $"diskChart_{diskName.Replace(":", "")}";
                await JSRuntime.InvokeVoidAsync("renderBarChart", id, labels, disk.Value, $"Disk {diskName}", "#3498db", new { yMax = 100 });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    void ManualRefresh() => _ = LoadData();
}
