@page "/agents"
@using ManagerServer.Models.Dto
@inject HttpClient Http
@inject string ApiBaseUrl

<h3>Add new agent</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @GetAlertClass(messageType)" role="alert">
        @message
    </div>
}

<div class="alert-form">

    <label>Agent ID:</label>
    <input @bind="agentId" readonly="@isEditing" />

    <label>Auth token:</label>
    <input @bind="authToken" />

    <label class="mt-3">Select metrics to collect:</label>
    <div class="mt-2 d-flex flex-column align-items-start">
        @foreach (var metric in allMetrics)
        {
            <div class="d-flex justify-content-between align-items-center mb-2" style="width: 250px;">
                <label class="form-label mb-0">@metric.Label</label>
                <input class="form-check-input"
                       type="checkbox"
                       @bind="metric.IsSelected"
                       style="width: 1.2rem; height: 1.2rem;" />
            </div>
        }
    </div>

    @if (!isEditing)
    {
        <button class="btn btn-primary mt-3 me-2" @onclick="CreateAgent">Create</button>
        <button class="btn btn-success mt-3" @onclick="SaveAgentOnly">Save to database</button>
    }
    else
    {
        <button class="btn btn-warning mt-3 me-2" @onclick="UpdateAgent">Update</button>
        <button class="btn btn-secondary mt-3" @onclick="CancelEdit">Cancel</button>
    }

    @if (!string.IsNullOrEmpty(generatedCommand))
    {
        <div class="mt-4">
            <label class="fw-bold">PowerShell command:</label>
            <pre style="white-space: pre-wrap; word-break: break-all; max-width: 100%;">
                @generatedCommand
            </pre>
        </div>
    }
</div>

<hr />

<h4>Existing agents</h4>

@if (agents == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Agent ID</th>
                <th>Auth Token</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in agents)
            {
                <tr>
                    <td>@a.AgentId</td>
                    <td>@a.AuthToken</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-2" @onclick="() => EditAgent(a)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAgent(a.AgentId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    string agentId = "";
    string authToken = "";
    string generatedCommand = "";
    bool isEditing = false;

    string message = "";
    string messageType = "";

    List<AgentDto> agents = new();

    class MetricOption
    {
        public string Label { get; set; } = "";
        public string Flag { get; set; } = "";
        public bool IsSelected { get; set; } = true;
    }

    List<MetricOption> allMetrics = new()
    {
        new() { Label = "CPU", Flag = "collectCpuData" },
        new() { Label = "RAM", Flag = "collectRamData" },
        new() { Label = "GPU", Flag = "collectGpuData" },
        new() { Label = "DISKS", Flag = "collectDiskData" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAgents();
    }

    async Task LoadAgents()
    {
        agents = await Http.GetFromJsonAsync<List<AgentDto>>($"{ApiBaseUrl}/api/agent-management");
    }

    string GetAlertClass(string type) =>
        type switch
        {
            "success" => "alert-success",
            "warning" => "alert-warning",
            "error" => "alert-danger",
            "info" => "alert-info",
            _ => "alert-secondary"
        };

    async Task CreateAgent()
    {
        if (string.IsNullOrWhiteSpace(agentId) || string.IsNullOrWhiteSpace(authToken))
        {
            message = "Agent ID and Auth Token cannot be empty.";
            messageType = "warning";
            return;
        }

        if (agents.Any(a => a.AgentId == agentId))
        {
            message = "Agent with this ID already exists.";
            messageType = "error";
            return;
        }

        var flags = allMetrics
            .Select(m => $"-{m.Flag}:{(m.IsSelected ? 1 : 0)}")
            .ToList();

        generatedCommand =
            $"powershell -ExecutionPolicy Bypass -Command \"iwr https://raw.githubusercontent.com/MrugalskiMichal/inzynierka/final-release/AgentInstall.ps1 -OutFile AgentInstall.ps1; .\\AgentInstall.ps1 -agentId '{agentId}' -authToken '{authToken}' -serverAddress '{ApiBaseUrl}/api/metrics' {string.Join(" ", flags)}\"";

        message = "PowerShell command generated successfully.";
        messageType = "success";

        await LoadAgents();
    }

    async Task SaveAgentOnly()
    {
        if (string.IsNullOrWhiteSpace(agentId) || string.IsNullOrWhiteSpace(authToken))
        {
            message = "Agent ID and Auth Token cannot be empty.";
            messageType = "warning";
            return;
        }

        if (agents.Any(a => a.AgentId == agentId))
        {
            message = "Agent with this ID already exists.";
            messageType = "error";
            return;
        }

        var agent = new AgentDto { AgentId = agentId, AuthToken = authToken };
        await Http.PostAsJsonAsync($"{ApiBaseUrl}/api/agent-management", agent);

        message = "Agent saved to database.";
        messageType = "success";

        await LoadAgents();
    }

    void EditAgent(AgentDto a)
    {
        agentId = a.AgentId;
        authToken = a.AuthToken;
        isEditing = true;

        message = $"Editing agent {a.AgentId}.";
        messageType = "info";
    }

    async Task UpdateAgent()
    {
        var agent = new AgentDto { AgentId = agentId, AuthToken = authToken };
        await Http.PutAsJsonAsync($"{ApiBaseUrl}/api/agent-management", agent);

        isEditing = false;
        agentId = "";
        authToken = "";

        message = "Agent updated successfully.";
        messageType = "success";

        await LoadAgents();
    }

    void CancelEdit()
    {
        isEditing = false;
        agentId = "";
        authToken = "";

        message = "Edit cancelled.";
        messageType = "info";
    }

    async Task DeleteAgent(string id)
    {
        await Http.DeleteAsync($"{ApiBaseUrl}/api/agent-management/{id}");

        message = "Agent deleted.";
        messageType = "success";

        await LoadAgents();
    }
}
